{
  "expo": {
    "name": "ChatVault",
    "slug": "chatvault",
    "version": "0.1.1",
    "scheme": "chatvault",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.boydem.app",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "בוידעם",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.chatvault.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsFileWithMaxCount": 1,
            "NSExtensionActivationSupportsText": false,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 0
          },
          "iosShareExtensionName": "ChatVault Import",
          "androidIntentFilters": [
            "text/plain",
            "application/zip"
          ],
          "iosAppGroupIdentifier": "group.com.boydem.app"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.139728547435-dsthuhtrdt4kqgvp5o23seuvsf5l3omr"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "webUrl": "https://boidem-delta.vercel.app",
      "router": {},
      "eas": {
        "projectId": "8110d656-c17d-4831-bf6d-931fd499af6f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yehonatancohen",
    "updates": {
      "url": "https://u.expo.dev/8110d656-c17d-4831-bf6d-931fd499af6f"
    }
  }
}
